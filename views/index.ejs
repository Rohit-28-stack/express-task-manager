<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/index.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">



</head>

<body>
  <div class="main w-full min-h-screen bg-zinc-900">
    <div class="form p-10 text-white">
      <form action="/create" method="post">
        <input class="block w-full rounded-md  outline-none outline-none px-5 py-2 bg-zinc-800" type="text"
          placeholder="Tittle goes here..." name="title">
        <textarea class="block w-full rounded-md outline-none  mt-2 px-5 py-2 resize-none bg-zinc-800"
          placeholder="write your task details..." name="details"></textarea>
        <input class="mt-2 bg-blue-600 px-5 py-2 rounded-md" type="submit" value="create tasks">
      </form>
    </div>
    <div class="tasks p-10 flex gap-3 flex-wrap ">
      <% if (files.length> 0) { %>
        <% files.forEach(function(val){%>
          <div class="task relative w-72  px-3 py-4 bg-zinc-800 rounded-md text-white">
            <a  href="/delete/<%=val%>"><i class="fa-solid top-2 right-2 fa-xmark absolute  cursor-pointer text-red-500 hover:text-red-700"></i></a>
            <h1 class="text-white text-3xl tracking-tighter">
              <%= val %>
            </h1>
            <div class="flex w-full mt-3 justify-between items-center">
              <a class="text-blue-600 inline-block  " href="/files/<%=val%>">Read more..</a>
              <a class="text-zinc-600" href="/edit/<%=val%>">Edit filename</a>
            </div>
          </div>
          <% })%>
            <%}else{%>
              <h3 class="text-zinc-600">no task yet</h3>
              <% }%>

    </div>
  </div>
</body>

</html>